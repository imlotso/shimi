.detail-page {
  min-height: 100vh;
  padding-bottom: 56rpx;
  background: #f4efe4;
}

.dish-visual {
  position: relative;
  height: 430rpx;
  overflow: hidden;
  background: #181713;
}

.dish-image {
  width: 100%;
  height: 430rpx;
}

.dish-label {
  position: absolute;
  left: 28rpx;
  bottom: 28rpx;
  height: 50rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #eaf4d6;
  color: #181713;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 50rpx;
}

.dish-head {
  margin: 24rpx 28rpx 0;
  padding: 28rpx;
  border: 2rpx solid rgba(70, 52, 34, 0.08);
  border-radius: 18rpx;
  background: #fffdf6;
  box-shadow: 0 18rpx 42rpx rgba(81, 59, 35, 0.08);
}

.dish-title-line {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
}

.dish-title-copy {
  flex: 1;
  min-width: 0;
}

.dish-name {
  display: block;
  font-size: 54rpx;
  line-height: 1.08;
  font-weight: 900;
  letter-spacing: 0;
}

.dish-subtitle {
  display: block;
  margin-top: 14rpx;
  color: #74695b;
  font-size: 25rpx;
  line-height: 1.5;
}

.favorite-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 64rpx;
  border: 2rpx solid rgba(24, 23, 19, 0.76);
  border-radius: 14rpx;
  color: #181713;
  font-size: 24rpx;
  font-weight: 900;
}

.favorite-button.active {
  background: #d86546;
  border-color: #d86546;
  color: #fffdf6;
}

.dish-metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 26rpx;
}

.metric {
  min-height: 98rpx;
  padding: 14rpx 8rpx;
  border-radius: 14rpx;
  background: #f4efe4;
  text-align: center;
}

.metric-main {
  display: block;
  font-size: 30rpx;
  font-weight: 900;
}

.metric-sub {
  display: block;
  margin-top: 6rpx;
  color: #81786b;
  font-size: 20rpx;
}

.detail-tags {
  margin-top: 22rpx;
}

.detail-section {
  margin: 0 28rpx;
}

.section-head.compact {
  margin-top: 32rpx;
}

.ingredient-sheet {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.detail-ingredient {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  gap: 10rpx;
  padding: 12rpx 12rpx 12rpx 16rpx;
  border: 2rpx solid rgba(70, 52, 34, 0.07);
  border-radius: 16rpx;
  background: #fffdf6;
  box-shadow: 0 10rpx 24rpx rgba(81, 59, 35, 0.04);
}

.detail-ingredient-copy {
  display: grid;
  grid-template-columns: 16rpx 1fr;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.ingredient-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #d86546;
}

.detail-ingredient-name {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 25rpx;
  font-weight: 900;
}

.detail-ingredient-amount {
  grid-column: 2;
  margin-top: 6rpx;
  color: #81786b;
  font-size: 22rpx;
}

.detail-ingredient-img {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: #e8ddcb;
}

.step-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.step-item {
  display: grid;
  grid-template-columns: 56rpx 1fr;
  gap: 16rpx;
  align-items: center;
  min-height: 126rpx;
  padding: 16rpx 16rpx 16rpx 18rpx;
  border: 2rpx solid rgba(70, 52, 34, 0.07);
  border-radius: 16rpx;
  background: #fffdf6;
  box-shadow: 0 12rpx 28rpx rgba(81, 59, 35, 0.05);
}

.step-item.with-image {
  grid-template-columns: 56rpx 1fr 176rpx;
}

.step-item.text-only {
  min-height: 118rpx;
}

.step-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: #181713;
  color: #fffdf6;
  font-size: 24rpx;
  font-weight: 900;
}

.step-copy {
  color: #343129;
  font-size: 26rpx;
  line-height: 1.6;
}

.step-visual {
  position: relative;
  width: 176rpx;
  height: 106rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #eadcc8;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.4);
}

.step-stage-img,
.step-final-img {
  width: 100%;
  height: 100%;
}

.detail-empty {
  min-height: 100vh;
  padding: 220rpx 48rpx 0;
  background: #f4efe4;
  text-align: center;
}

.empty-title {
  display: block;
  color: #181713;
  font-size: 34rpx;
  font-weight: 900;
}

.empty-copy {
  display: block;
  margin-top: 18rpx;
  color: #81786b;
  font-size: 26rpx;
}

.nutrition-note {
  margin: 32rpx 28rpx 0;
  padding: 22rpx;
  border-left: 6rpx solid #cde88f;
  border-radius: 16rpx;
  background: #fffdf6;
}

.note-title {
  display: block;
  font-size: 26rpx;
  font-weight: 900;
}

.note-copy {
  display: block;
  margin-top: 8rpx;
  color: #81786b;
  font-size: 23rpx;
  line-height: 1.55;
}

.related-row {
  display: flex;
  gap: 16rpx;
  margin: 0 28rpx;
  overflow-x: auto;
}

.related-card {
  width: 220rpx;
  flex: 0 0 220rpx;
  overflow: hidden;
  border: 2rpx solid rgba(70, 52, 34, 0.07);
  border-radius: 16rpx;
  background: #fffdf6;
  text-align: left;
  box-shadow: 0 12rpx 28rpx rgba(81, 59, 35, 0.06);
}

.related-img {
  width: 220rpx;
  height: 146rpx;
}

.related-name {
  display: block;
  padding: 12rpx 14rpx 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 25rpx;
  font-weight: 900;
}

.related-meta {
  display: block;
  padding: 8rpx 14rpx 16rpx;
  color: #81786b;
  font-size: 21rpx;
}
