.audit-page {
  padding-bottom: 80rpx;
}

.retry-btn {
  margin: 28rpx auto 0;
}

.audit-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.audit-card {
  display: flex;
  overflow: hidden;
  border: 2rpx solid rgba(70, 52, 34, 0.08);
  border-radius: 16rpx;
  background: #fffdf6;
  box-shadow: 0 14rpx 32rpx rgba(81, 59, 35, 0.06);
}

.audit-card-img {
  flex: 0 0 148rpx;
  width: 148rpx;
  height: 148rpx;
  background: #e8ddcb;
}

.audit-card-body {
  flex: 1;
  min-width: 0;
  padding: 18rpx 20rpx;
}

.audit-card-name {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 30rpx;
  font-weight: 900;
}

.audit-card-meta {
  display: block;
  margin-top: 10rpx;
  color: #81786b;
  font-size: 23rpx;
}

.audit-card-tags {
  display: block;
  margin-top: 10rpx;
  color: #5a7829;
  font-size: 23rpx;
}

.audit-card-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.mini-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.mini-btn.ghost {
  border: 2rpx solid rgba(24, 23, 19, 0.16);
  color: #343129;
}

.mini-btn.approve {
  background: #eaf4d6;
  color: #49652a;
}

.mini-btn.danger {
  border: 2rpx solid rgba(189, 87, 60, 0.35);
  color: #bd573c;
}

.reject-box {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid rgba(70, 52, 34, 0.08);
}

.reject-input {
  width: 100%;
  height: 72rpx;
  padding: 0 18rpx;
  border: 2rpx solid rgba(189, 87, 60, 0.3);
  border-radius: 10rpx;
  background: #fffdf6;
  color: #181713;
  font-size: 26rpx;
}

.field-placeholder {
  color: #9b9389;
}

.reject-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 12rpx;
}

.empty-copy {
  padding: 0 20rpx;
}