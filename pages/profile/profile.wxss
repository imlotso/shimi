.profile-page {
  padding-bottom: 64rpx;
}

.profile-hero {
  position: relative;
  min-height: 250rpx;
  overflow: hidden;
  padding: 34rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #171511, #242016 60%, #20342f);
  color: #fffdf6;
  box-shadow: 0 20rpx 48rpx rgba(61, 44, 26, 0.16);
}

.profile-hero::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #73c7be, #cde88f, #e58a65);
}

.profile-hero-copy {
  position: relative;
  z-index: 2;
  width: 430rpx;
}

.profile-kicker {
  display: block;
  color: #cde88f;
  font-size: 23rpx;
  font-weight: 900;
}

.profile-title {
  display: block;
  margin-top: 16rpx;
  font-size: 48rpx;
  line-height: 1.1;
  font-weight: 900;
}

.profile-copy {
  display: block;
  width: 420rpx;
  margin-top: 14rpx;
  color: rgba(255, 253, 246, 0.72);
  font-size: 24rpx;
  line-height: 1.5;
}

.profile-hero-img {
  position: absolute;
  right: 22rpx;
  bottom: 26rpx;
  width: 176rpx;
  height: 176rpx;
  border: 2rpx solid rgba(255, 253, 246, 0.13);
  border-radius: 42rpx;
  background: #e8ddcb;
  box-shadow: 0 22rpx 42rpx rgba(0, 0, 0, 0.22);
}

.profile-hero-img.avatar {
  border: 4rpx solid rgba(255, 253, 246, 0.18);
}

.profile-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
}

.profile-action {
  min-height: 140rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(70, 52, 34, 0.06);
  box-shadow: 0 14rpx 32rpx rgba(81, 59, 35, 0.06);
  text-align: left;
}

.profile-action.lime {
  background: linear-gradient(145deg, #f3f8e7, #dceebb);
}

.profile-action.blue {
  background: linear-gradient(145deg, #edf8f7, #dcefed);
}

.action-title {
  display: block;
  font-size: 28rpx;
  font-weight: 900;
}

.action-copy {
  display: block;
  margin-top: 10rpx;
  color: #6a5f52;
  font-size: 22rpx;
  line-height: 1.4;
}

.feedback-card {
  position: relative;
  overflow: hidden;
  margin-top: 24rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(70, 52, 34, 0.08);
  border-radius: 18rpx;
  background: linear-gradient(145deg, #fffdf6 0%, #f7f1e6 62%, #eef6e5 100%);
  box-shadow: 0 18rpx 42rpx rgba(81, 59, 35, 0.08);
}

.feedback-card::before {
  content: "";
  position: absolute;
  top: -58rpx;
  right: -48rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  background: rgba(205, 232, 143, 0.55);
}

.feedback-card::after {
  content: "";
  position: absolute;
  right: 34rpx;
  bottom: 32rpx;
  width: 82rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #181713;
  box-shadow: -28rpx -20rpx 0 #73c7be, -56rpx -40rpx 0 #e58a65;
  opacity: 0.18;
}

.feedback-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.feedback-kicker {
  display: block;
  color: #5a7829;
  font-size: 22rpx;
  font-weight: 900;
}

.feedback-title {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 900;
}

.feedback-badge {
  flex: 0 0 auto;
  height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #181713;
  color: #fffdf6;
  font-size: 22rpx;
  line-height: 46rpx;
  font-weight: 900;
}

.feedback-textarea {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 178rpx;
  min-height: 178rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  border: 2rpx solid rgba(70, 52, 34, 0.1);
  border-radius: 16rpx;
  background: rgba(255, 253, 246, 0.9);
  color: #181713;
  font-size: 26rpx;
  line-height: 1.55;
}

.feedback-placeholder {
  color: #9b9389;
  font-size: 25rpx;
}

.feedback-footer {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.feedback-count {
  color: #81786b;
  font-size: 22rpx;
  font-weight: 700;
}

.feedback-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 176rpx;
  height: 70rpx;
  padding: 0 26rpx;
  border-radius: 14rpx;
  background: #181713;
  color: #fffdf6;
  font-size: 25rpx;
  font-weight: 900;
}

.feedback-submit.loading {
  opacity: 0.72;
}

.feedback-message {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  font-size: 23rpx;
  line-height: 1.4;
  font-weight: 700;
}

.feedback-message.success {
  background: #eaf4d6;
  color: #49652a;
}

.feedback-message.error {
  background: #f9e4d8;
  color: #a64b34;
}

.profile-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.profile-recipe {
  display: flex;
  width: 100%;
  overflow: hidden;
  min-height: 132rpx;
  border: 2rpx solid rgba(70, 52, 34, 0.07);
  border-radius: 16rpx;
  background: #fffdf6;
  text-align: left;
  box-shadow: 0 14rpx 32rpx rgba(81, 59, 35, 0.06);
}

.profile-recipe-img {
  flex: 0 0 132rpx;
  width: 132rpx;
  height: 132rpx;
}

.profile-recipe-body {
  flex: 1;
  min-width: 0;
  padding: 20rpx;
}

.profile-recipe-name {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 30rpx;
  font-weight: 900;
}

.profile-recipe-meta {
  display: block;
  margin-top: 12rpx;
  color: #81786b;
  font-size: 23rpx;
}

.history-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.history-card {
  overflow: hidden;
  border: 2rpx solid rgba(70, 52, 34, 0.07);
  border-radius: 16rpx;
  background: #fffdf6;
  text-align: left;
  box-shadow: 0 12rpx 28rpx rgba(81, 59, 35, 0.06);
}

.history-img {
  width: 100%;
  height: 132rpx;
}

.history-name {
  display: block;
  padding: 12rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 23rpx;
  font-weight: 900;
}
