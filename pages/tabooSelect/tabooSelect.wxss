.page{
  padding:30rpx 24rpx;
  background:#f4efe4;
  min-height:100vh;
}
.title{
  font-size:36rpx;
  font-weight:bold;
  margin-bottom:12rpx;
}
.tip{
  font-size:26rpx;
  color:#777;
  margin-bottom:32rpx;
}
.grid{
  display:grid;
  grid-template-columns: repeat(2,1fr);
  gap:16rpx;
}
.card{
  position:relative;
  background:#fff;
  border-radius:16rpx;
  padding:24rpx 12rpx;
  text-align:center;
  border:2rpx solid transparent;
}
.card.active{
  border-color:#a4c868;
  background:#eaf4d6;
}
.img{
  width:80rpx;
  height:80rpx;
  border-radius:12rpx;
}
.name{
  display:block;
  margin-top:10rpx;
  font-size:28rpx;
}
.check{
  position:absolute;
  top:8rpx;
  right:10rpx;
  font-size:30rpx;
  color:#397300;
  font-weight:bold;
}
.submit-wrap{
  margin-top:80rpx;
}
.submit-btn{
  background:#d86048;
  color:#fff;
  border-radius:14rpx;
}
