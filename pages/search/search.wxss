.search-page {
  padding-bottom: 64rpx;
}

.catalog-hero {
  position: relative;
  min-height: 250rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #171511, #20241b 62%, #223530);
  color: #fffdf6;
  box-shadow: 0 20rpx 48rpx rgba(61, 44, 26, 0.16);
}

.catalog-hero::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #cde88f, #73c7be, #e58a65);
}

.catalog-copy {
  position: relative;
  z-index: 2;
  width: 430rpx;
}

.catalog-kicker {
  display: block;
  color: #cde88f;
  font-size: 22rpx;
  font-weight: 900;
}

.catalog-title {
  display: block;
  margin-top: 14rpx;
  font-size: 42rpx;
  line-height: 1.12;
  font-weight: 900;
}

.catalog-sub {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 253, 246, 0.74);
  font-size: 23rpx;
  line-height: 1.45;
}

.catalog-img {
  position: absolute;
  right: 22rpx;
  bottom: 26rpx;
  width: 224rpx;
  height: 156rpx;
  border: 2rpx solid rgba(255, 253, 246, 0.13);
  border-radius: 16rpx;
  background: #e8ddcb;
  box-shadow: 0 22rpx 42rpx rgba(0, 0, 0, 0.22);
}

.search-top {
  margin-bottom: 20rpx;
}

.search-input-shell {
  display: flex;
  align-items: center;
  height: 90rpx;
  padding: 0 18rpx 0 24rpx;
  border: 2rpx solid rgba(70, 52, 34, 0.08);
  border-radius: 16rpx;
  background: #fffdf6;
  box-shadow: 0 14rpx 34rpx rgba(81, 59, 35, 0.06);
}

.search-symbol {
  margin-right: 14rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.search-input {
  flex: 1;
  height: 88rpx;
  font-size: 27rpx;
}

.search-clear {
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #181713;
  color: #fffdf6;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-row {
  display: flex;
  gap: 14rpx;
  padding-bottom: 4rpx;
}

.filter-pill {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 0 0 188rpx;
  width: 188rpx;
  height: 92rpx;
  padding: 0 18rpx;
  border: 2rpx solid rgba(70, 52, 34, 0.08);
  border-radius: 16rpx;
  background: rgba(255, 253, 246, 0.94);
  color: #685e50;
  box-shadow: 0 10rpx 24rpx rgba(81, 59, 35, 0.04);
  text-align: left;
}

.filter-pill.active {
  border-color: rgba(89, 118, 52, 0.36);
  background: linear-gradient(135deg, #eaf4d6, #d8edab);
  color: #181713;
  box-shadow: 0 12rpx 28rpx rgba(89, 118, 52, 0.13);
  transform: translateY(-2rpx);
}

.filter-name {
  display: block;
  font-size: 26rpx;
  font-weight: 900;
}

.filter-copy {
  display: block;
  margin-top: 8rpx;
  color: rgba(24, 23, 19, 0.54);
  font-size: 20rpx;
  font-weight: 800;
}

.result-count {
  margin: 26rpx 0 18rpx;
  color: #81786b;
  font-size: 24rpx;
  font-weight: 800;
}

.search-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
}

.search-card {
  position: relative;
  display: flex;
  width: 100%;
  overflow: hidden;
  min-height: 224rpx;
  border: 2rpx solid rgba(70, 52, 34, 0.07);
  border-radius: 16rpx;
  background: #fffdf6;
  text-align: left;
  box-shadow: 0 20rpx 48rpx rgba(81, 59, 35, 0.08);
}

.search-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: #cde88f;
}

.search-card-img {
  flex: 0 0 238rpx;
  width: 238rpx;
  height: 224rpx;
  background: #e8ddcb;
}

.search-card-body {
  flex: 1;
  min-width: 0;
  padding: 20rpx 20rpx 18rpx;
}

.search-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.search-card-name {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 32rpx;
  font-weight: 900;
}

.search-card-rating {
  color: #d86546;
  font-size: 22rpx;
  font-weight: 900;
}

.search-card-sub {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: #74695b;
  font-size: 24rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.search-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 14rpx 0;
  color: #181713;
  font-size: 22rpx;
  font-weight: 800;
}
