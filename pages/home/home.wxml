<view class="page home-page">
  <view class="hero">
    <view class="hero-copy">
      <text class="hero-kicker">下班 30 分钟开饭</text>
      <text class="hero-title">今晚有谱</text>
      <text class="hero-subtitle">选几样食材，直接给你排出靠谱晚餐。</text>
      <view class="hero-tags">
        <text class="hero-tag">智能配菜</text>
        <text class="hero-tag">新手友好</text>
        <text class="hero-tag">减脂可选</text>
      </view>
    </view>
    <image wx:if="{{heroRecipe}}" class="hero-image" src="{{heroRecipe.image}}" mode="aspectFill" />
  </view>

  <view class="search-box">
    <text class="search-icon">⌕</text>
    <input
      class="search-input"
      placeholder="搜菜名或食材"
      value="{{searchText}}"
      confirm-type="search"
      bindinput="onSearchInput"
      bindconfirm="goSearch"
    />
    <button class="search-button" bindtap="goSearch">搜索</button>
  </view>

  <view class="decision-strip">
    <button class="decision-main" bindtap="goRecommendations">
      <text class="decision-label">用已选食材配一餐</text>
      <text class="decision-copy">{{selectedIds.length ? '查看今晚推荐' : '先去选食材'}}</text>
    </button>
    <button class="decision-secondary" bindtap="goFatLoss">
      <text class="decision-label">减脂轻食</text>
      <text class="decision-copy">低油高蛋白</text>
    </button>
  </view>

  <view class="section-head">
    <text class="section-title">常用食材</text>
    <button class="section-action" bindtap="goIngredients">更多食材</button>
  </view>
  <scroll-view scroll-x class="ingredient-scroll" enable-flex>
    <view class="ingredient-row">
      <view wx:for="{{quickIngredientColumns}}" wx:key="id" class="ingredient-column">
        <button
          wx:for="{{item.items}}"
          wx:for-item="ingredient"
          wx:key="id"
          class="ingredient-chip {{ingredient.selected ? 'active' : ''}}"
          data-id="{{ingredient.id}}"
          bindtap="toggleIngredient"
        >
          <image class="ingredient-chip-img" src="{{ingredient.image}}" mode="aspectFit" />
          <text>{{ingredient.name}}</text>
        </button>
      </view>
    </view>
  </scroll-view>

  <view class="tool-grid">
    <button class="tool-card green" bindtap="goIngredients">
      <text class="tool-symbol">+</text>
      <text class="tool-title">冰箱盘点</text>
      <text class="tool-copy">把现有食材点出来</text>
    </button>
    <button class="tool-card blue" bindtap="goSearch">
      <text class="tool-symbol">⌕</text>
      <text class="tool-title">菜名直达</text>
      <text class="tool-copy">想吃什么直接搜</text>
    </button>
    <button class="tool-card coral" bindtap="goFatLoss">
      <text class="tool-symbol">↗</text>
      <text class="tool-title">轻食计划</text>
      <text class="tool-copy">今天吃轻一点</text>
    </button>
  </view>

  <view class="section-head">
    <text class="section-title">今晚高胜率</text>
    <button class="section-action" bindtap="goSearch">全部菜谱</button>
  </view>
  <view class="recipe-grid">
    <view
      wx:for="{{hotRecipes}}"
      wx:key="id"
      class="recipe-card home-recipe"
      hover-class="tap-card"
      data-id="{{item.id}}"
      bindtap="openRecipe"
    >
      <image class="recipe-image home-recipe-img" src="{{item.image}}" mode="aspectFill" />
      <view class="home-recipe-body">
        <view class="home-recipe-line">
          <text class="home-recipe-name">{{item.name}}</text>
          <text class="home-recipe-time">{{item.time}} 分钟</text>
        </view>
        <text class="home-recipe-sub">{{item.subtitle}}</text>
        <view class="tag-row">
          <text class="tag {{item.fatLoss ? 'green' : 'red'}}">{{item.fatLoss ? '减脂友好' : item.category}}</text>
          <text class="tag blue">{{item.difficulty}} 星难度</text>
        </view>
      </view>
    </view>
  </view>
</view>
