.home-page {
  padding-bottom: 58rpx;
}

.hero {
  position: relative;
  display: flex;
  min-height: 356rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #171511 0%, #242016 58%, #1c2a25 100%);
  color: #fffdf6;
  box-shadow: 0 24rpx 58rpx rgba(61, 44, 26, 0.18);
}

.hero::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #cde88f, #73c7be, #e58a65);
}

.hero-copy {
  position: relative;
  z-index: 2;
  width: 58%;
  padding: 40rpx 0 42rpx 36rpx;
}

.hero-kicker {
  display: block;
  color: #cde88f;
  font-size: 24rpx;
  font-weight: 800;
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  font-size: 74rpx;
  line-height: 0.96;
  font-weight: 900;
  letter-spacing: 0;
}

.hero-subtitle {
  display: block;
  width: 340rpx;
  margin-top: 20rpx;
  color: rgba(255, 253, 246, 0.78);
  font-size: 26rpx;
  line-height: 1.45;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 26rpx;
}

.hero-tag {
  height: 42rpx;
  padding: 0 14rpx;
  border: 2rpx solid rgba(255, 253, 246, 0.14);
  border-radius: 10rpx;
  color: #fffdf6;
  font-size: 22rpx;
  line-height: 38rpx;
}

.hero-image {
  position: absolute;
  right: 24rpx;
  bottom: 34rpx;
  width: 284rpx;
  height: 214rpx;
  border: 2rpx solid rgba(255, 253, 246, 0.13);
  border-radius: 16rpx;
  background: #e8ddcb;
  box-shadow: 0 28rpx 58rpx rgba(0, 0, 0, 0.26);
}

.search-box {
  display: flex;
  align-items: center;
  height: 92rpx;
  margin-top: 24rpx;
  padding: 0 12rpx 0 26rpx;
  border: 2rpx solid rgba(70, 52, 34, 0.08);
  border-radius: 18rpx;
  background: #fffdf6;
  box-shadow: 0 16rpx 38rpx rgba(81, 59, 35, 0.07);
}

.search-icon {
  margin-right: 16rpx;
  color: #181713;
  font-size: 36rpx;
  font-weight: 800;
}

.search-input {
  flex: 1;
  height: 90rpx;
  color: #181713;
  font-size: 26rpx;
}

.search-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 126rpx;
  height: 68rpx;
  border-radius: 14rpx;
  background: #cde88f;
  color: #181713;
  font-size: 26rpx;
  font-weight: 900;
}

.decision-strip {
  display: grid;
  grid-template-columns: 1.45fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

.decision-main,
.decision-secondary {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 136rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  text-align: left;
}

.decision-main {
  background: linear-gradient(135deg, #e96f4d, #c5533c);
  color: #fffdf6;
  box-shadow: 0 18rpx 38rpx rgba(182, 78, 50, 0.18);
}

.decision-secondary {
  background: linear-gradient(135deg, #e4f3f1, #d6eadc);
  color: #181713;
  box-shadow: inset 0 0 0 2rpx rgba(62, 108, 93, 0.08);
}

.decision-label {
  font-size: 30rpx;
  font-weight: 900;
}

.decision-copy {
  margin-top: 12rpx;
  opacity: 0.72;
  font-size: 24rpx;
}

.ingredient-scroll {
  width: 100%;
  white-space: nowrap;
}

.ingredient-row {
  display: flex;
  gap: 14rpx;
  padding-bottom: 4rpx;
}

.ingredient-column {
  display: flex;
  flex-direction: column;
  flex: 0 0 160rpx;
  width: 160rpx;
  gap: 14rpx;
}

.ingredient-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: 160rpx;
  height: 72rpx;
  padding: 0 10rpx;
  border: 2rpx solid rgba(70, 52, 34, 0.08);
  border-radius: 14rpx;
  background: rgba(255, 253, 246, 0.92);
  color: #181713;
  font-size: 24rpx;
  font-weight: 800;
}

.ingredient-chip.active {
  border-color: rgba(89, 118, 52, 0.34);
  background: #eaf4d6;
  box-shadow: inset 0 0 0 2rpx rgba(205, 232, 143, 0.65);
}

.ingredient-chip-img {
  width: 46rpx;
  height: 46rpx;
  flex: 0 0 46rpx;
}

.ingredient-chip text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.tool-card {
  min-height: 172rpx;
  padding: 22rpx 16rpx;
  border-radius: 16rpx;
  text-align: left;
  border: 2rpx solid rgba(70, 52, 34, 0.06);
  box-shadow: 0 14rpx 32rpx rgba(81, 59, 35, 0.06);
}

.tool-card.green {
  background: linear-gradient(145deg, #f3f8e7, #e6f2d1);
}

.tool-card.blue {
  background: linear-gradient(145deg, #edf8f7, #dcefed);
}

.tool-card.coral {
  background: linear-gradient(145deg, #fff4ec, #f6e3d8);
}

.tool-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: #181713;
  color: #fffdf6;
  font-size: 28rpx;
  font-weight: 900;
}

.tool-title {
  display: block;
  margin-top: 20rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.tool-copy {
  display: block;
  margin-top: 8rpx;
  color: #6a5f52;
  font-size: 22rpx;
  line-height: 1.3;
}

.recipe-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.home-recipe {
  width: 100%;
  text-align: left;
  box-shadow: 0 20rpx 48rpx rgba(81, 59, 35, 0.08);
}

.home-recipe-img {
  height: 198rpx;
}

.home-recipe-body {
  padding: 18rpx;
}

.home-recipe-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.home-recipe-name {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 29rpx;
  font-weight: 900;
}

.home-recipe-time {
  color: #d86546;
  font-size: 21rpx;
  font-weight: 900;
}

.home-recipe-sub {
  display: -webkit-box;
  min-height: 66rpx;
  margin: 10rpx 0 14rpx;
  overflow: hidden;
  color: #6a5f52;
  font-size: 22rpx;
  line-height: 1.5;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
